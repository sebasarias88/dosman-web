---
import CartButton from '@/components/cart/CartButton'
import OpenBadge from './OpenBadge'

const path = Astro.url.pathname
const links = [
  { href: '/menu', label: 'Menú' },
  { href: '/#como-pedir', label: 'Cómo pedir' },
  { href: '/#ubicacion', label: 'Dónde estamos' },
]
---

<header class="glass-light sticky top-0 z-40 border-b border-line/70">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-3 px-4 sm:h-[72px] sm:px-6">
    <a href="/" class="shrink-0" aria-label="Dosman, ir al inicio">
      <span
        role="img"
        aria-label="Dosman · Cholao & Coffee"
        class="brand-logo block aspect-[770/221] h-9 bg-fg sm:h-10"></span>
    </a>

    <nav aria-label="Principal" class="ml-6 hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={path === l.href ? 'page' : undefined}
            class="rounded-full px-4 py-2 text-[15px] font-semibold text-muted transition-colors hover:bg-surface hover:text-fg aria-[current=page]:bg-surface aria-[current=page]:text-fg"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <OpenBadge client:load />
      <CartButton client:load />
    </div>
  </div>
</header>

<style>
  .brand-logo {
    mask: url(/brand/logo-horizontal-current.svg) left center / contain no-repeat;
    -webkit-mask: url(/brand/logo-horizontal-current.svg) left center / contain no-repeat;
  }
</style>
