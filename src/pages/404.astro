---
import Base from '@/layouts/Base.astro'
import { store } from '@/data/store'
---

<Base title="Página no encontrada" description="Esta página no existe." noindex>
  <section class="mx-auto max-w-4xl px-4 py-24 sm:px-6 sm:py-32">
    <p class="price font-display text-[clamp(6rem,22vw,14rem)] leading-none text-accent">404</p>
    <h1 class="mt-4 font-display text-5xl sm:text-6xl">Esta página se derritió.</h1>
    <p class="mt-4 max-w-md text-lg text-muted">El enlace está mal escrito o la página ya no existe. El menú sigue en su sitio.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/menu" class="btn btn-primary">Ver el menú</a>
      <a href={`https://wa.me/${store.whatsapp}`} target="_blank" rel="noopener" class="btn btn-ghost">Escribir por WhatsApp</a>
    </div>
  </section>
</Base>
